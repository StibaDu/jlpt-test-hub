{
  "name": "jlpt-test-hub-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jlpt-test-hub",
      "database_id": ""
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": ""
    },
    {
      "binding": "RATE_LIMIT",
      "id": ""
    }
  ],
  "vars": {
    "JWT_SECRET": "",
    "JWT_EXPIRY": "15m",
    "REFRESH_TOKEN_EXPIRY": "30d",
    "STRIPE_SECRET_KEY": "",
    "STRIPE_WEBHOOK_SECRET": "",
    "PAYPAL_CLIENT_ID": "",
    "PAYPAL_CLIENT_SECRET": "",
    "PAYPAL_WEBHOOK_ID": "",
    "EMAIL_FROM": "noreply@jlpttesthub.com",
    "APP_URL": "https://jlpttesthub.com"
  }
}